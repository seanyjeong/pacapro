-- Backup first. Apply before deploying code that selects classes.tuition_by_weekly.
-- 반별 학원비: 반마다 주1~7회 월 학원비 표를 따로 둘 수 있다. 모양은 학원 설정과 같다 {"weekly_1":..,"weekly_7":..}.
-- NULL = 학원 기본표를 그대로 쓴다(지금과 같음). 청구·일할계산은 학생에 저장된 학원비로 하므로 이 칸이 계산을 바꾸지 않는다.
-- Add at the end so MySQL 8 can use INSTANT without rebuilding existing rows.
SET @branch_schema = DATABASE();
SET @branch_sql = (
    SELECT IF(COUNT(*) = 0,
        'ALTER TABLE classes ADD COLUMN tuition_by_weekly JSON NULL, ALGORITHM=INSTANT',
        'SELECT 1')
    FROM information_schema.COLUMNS
    WHERE TABLE_SCHEMA = @branch_schema AND TABLE_NAME = 'classes' AND COLUMN_NAME = 'tuition_by_weekly'
);
PREPARE branch_stmt FROM @branch_sql;
EXECUTE branch_stmt;
DEALLOCATE PREPARE branch_stmt;

-- 바로 전 반 학원비 표(표를 바꿀 때 예전 값을 남긴다). NULL = 예전엔 학원 기본표.
-- "반 학원비 적용" 미리보기가 예전 표 금액과 다른 학생(개별 금액)을 알아보는 데만 쓴다.
SET @branch_sql = (
    SELECT IF(COUNT(*) = 0,
        'ALTER TABLE classes ADD COLUMN tuition_by_weekly_before JSON NULL, ALGORITHM=INSTANT',
        'SELECT 1')
    FROM information_schema.COLUMNS
    WHERE TABLE_SCHEMA = @branch_schema AND TABLE_NAME = 'classes' AND COLUMN_NAME = 'tuition_by_weekly_before'
);
PREPARE branch_stmt FROM @branch_sql;
EXECUTE branch_stmt;
DEALLOCATE PREPARE branch_stmt;
