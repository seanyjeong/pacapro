-- Manual rollback only. 채운 season_id 를 비우고 옛 season_settings 외래 키를 되돌린다(season_settings 가 비어 있어야 한다).
-- 되돌리면 새 시즌비 청구는 다시 season_id 없이 저장되고, 시즌 이름을 바꾼 뒤 등록 취소하면 시즌비 청구가 남을 수 있다.
UPDATE student_payments SET season_id = NULL WHERE payment_type = 'season' AND season_id IS NOT NULL;
ALTER TABLE student_payments ADD CONSTRAINT student_payments_ibfk_3 FOREIGN KEY (season_id) REFERENCES season_settings (id) ON DELETE SET NULL;
