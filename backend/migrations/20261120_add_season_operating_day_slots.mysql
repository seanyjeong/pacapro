-- Backup first. Apply before deploying code that writes seasons.operating_day_slots.
-- 요일별 운영 시간대: {"1":["morning","afternoon","evening"],"2":["morning","afternoon"]} (키 = 요일 0~6).
-- NULL = 모든 운영 요일에 같은 시간대(지금과 같음). 수업 일정만 따르고 일할계산·환불은 운영 요일로 센다.
-- Add at the end so MySQL 8 can use INSTANT without rebuilding existing rows.
SET @season_schema = DATABASE();
SET @season_sql = (
    SELECT IF(COUNT(*) = 0,
        'ALTER TABLE seasons ADD COLUMN operating_day_slots JSON NULL, ALGORITHM=INSTANT',
        'SELECT 1')
    FROM information_schema.COLUMNS
    WHERE TABLE_SCHEMA = @season_schema AND TABLE_NAME = 'seasons' AND COLUMN_NAME = 'operating_day_slots'
);
PREPARE season_stmt FROM @season_sql;
EXECUTE season_stmt;
DEALLOCATE PREPARE season_stmt;
